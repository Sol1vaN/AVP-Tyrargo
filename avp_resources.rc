#include <windows.h>
#include "src/tyrargo_version.h"
IDI_AVP_ICON ICON "avp2.ico"
1 VERSIONINFO
 FILEVERSION TYRARGO_PE_VERSION
 PRODUCTVERSION TYRARGO_PE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "AVP: Tyrargo contributors\0"
   VALUE "FileDescription", TYRARGO_PROJECT_NAME "\0"
   VALUE "FileVersion", TYRARGO_VERSION "\0"
   VALUE "InternalName", "avpt\0"
   VALUE "OriginalFilename", TYRARGO_EXECUTABLE "\0"
   VALUE "ProductName", TYRARGO_PROJECT_NAME "\0"
   VALUE "ProductVersion", TYRARGO_VERSION "\0"
   VALUE "Comments", "Direct fork of " TYRARGO_BASE "; based on Rebellion Developments AvP Gold source.\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
